rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profile: public read, owner write
    match /users/{userId}/profile {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // User skills: private to user
    match /users/{userId}/skills/{skillId} {
      allow read, write: if isOwner(userId);
    }
    
    // User goals & milestones: private to user
    match /users/{userId}/goals/{goalId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/milestones/{milestoneId} {
      allow read, write: if isOwner(userId);
    }
    
    // User practice sessions: private to user
    match /users/{userId}/practiceSessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }
    
    // User aggregated stats
    match /users/{userId}/stats/{statId} {
      allow read, write: if isOwner(userId);
    }
    
    // Community posts: all authenticated users can read and create; only owner can edit/delete
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      
      // Post likes: user can only like/unlike on their own UID
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
      
      // Post comments: authenticated create; only author can delete
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      }
    }
  }
}
